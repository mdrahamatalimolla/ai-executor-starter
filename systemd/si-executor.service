# Systemd unit example for running docker-compose (optional)
# Save as /etc/systemd/system/si-executor.service and run `sudo systemctl enable --now si-executor`

[Unit]
Description=Si AI agent (docker-compose)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/si-ai-agent
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
